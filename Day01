#4 대소문자 바꿔서 출력하기
str = input()
for i in str:
    if i > i.upper():
        i=i.upper()
    else:
        i=i.lower()
    print(i,end='') #if문을 사용하지않고 swapcasa(메소드)를 사용하여 한번에 가능
    
    

