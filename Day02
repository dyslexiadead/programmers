#1 덧셈식 출력하기
#잘못된 풀이
str= list(input())
a= int(str[0])
b= int(str[2])
print('%d + %d = %d'%(a,b,a+b))
#이유: 만약 입력값이 두자리수라면 리스트로 변환하는 과정에서 두자리수가 온전히 출력되지 않는다

#답
a, b = map(int, input().split())
print(f"{a} + {b} = {a + b}")
#map(함수)(map(함수, 특정요소)): 많은 요소에 특정 함수를 일괄적용할때 사용
#위 문제에서 입력값 '4 5'를 int로 변환뒤 다른 변수에 저장해야하기에 int,split사용
#split(메소드): 특정기준으로 쪼개서 리스트로 만듬

#2 문자열 붙여서 출력하기
