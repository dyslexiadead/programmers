#1 n의 배수
#오답
def solution(num, n):
    return print('1' if num%n==0 else '0')
#틀린 이유: 문제에서 요구하는 'return'값은 단순 print 값이 아닌 반환값을 원하기 때문임
#솔직히 잘 모르겠음;;

#답
def solution(num, n):
    return 1 if num%n==0 else 0

#2 공배수
def solution(number, n, m):
    return 1 if number%n == 0 and number%m== 0 else 0

#수정본
def solution(number, n, m):
    return 1 if number%(n*m) == 0 else 0
# 틀린이유:
# if문을 사용하지 않고 그냥 True False 를 이용하여 가능(True또는 False를 정수형으로 바꾸기)

