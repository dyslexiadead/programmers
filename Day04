#4 조건 문자열
def solution(ineq, eq, n, m):
    answer=0
    if ineq=='<':
        if eq=='=':
            answer=int(n<=m)
        else:
            answer=int(n<m)
    else:
        if eq=='=':
            answer=int(n>=m)
        else:
            answer=int(n>m)
    return answer
#본인이 생각하기에 중복된 if문이 많기에 줄이고 싶으며 또한 문자열로 제공되는
# 부등호를 바로 if문에 사용할수없는지 궁금함

#5 flag에 따라 다른 값 반환하기
def solution(a, b, flag):
    return a+b if flag else a-b
#flag가 boolean으로 나오기에 바로 사용가능(true=1,false=0)
