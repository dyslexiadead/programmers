#1 코드 처리하기
def solution(code):
    answer =''
    mode = 0
    for i in range(int(len(code))):
        if code[i]=='1':
            if mode==1:
                mode=0
                continue
            elif mode==0:
                mode=1
                continue
        if mode==0 and i%2==0:
            answer+=code[i]
        elif mode==1 and i%2==1:
            answer+=code[i]
    return answer if answer!='' else 'EMPTY'
#코드 수정: len()이 이미 정수형 
