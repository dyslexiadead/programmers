#3 주사위 게임 2
def solution(a, b, c):
    answer = 0
    solution=[a,b,c]
    if solution[0]==solution[1]:
        if solution[1]==solution[2] or solution[2]==solution[0]:
            #모두같
            answer+=(a+b+c)*((a**2)+(b**2)+(c**2))*((a**3)+(b**3)+(c**3))
        else:
            answer+=(a+b+c)*((a**2)+(b**2)+(c**2))
    else:
        if solution[1]==solution[2] or solution[2]==solution[0]:
            answer+=(a+b+c)*((a**2)+(b**2)+(c**2))
        else:
            answer+=(a+b+c)
    return answer
