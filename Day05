#4 원소들의 곱과 합
def solution(num_list):
    mul = 1
    for i in num_list:
        mul=mul*i
    return 1 if (sum(num_list))**2>mul else 0

#5 이어 붙인 수
def solution(num_list):
    even=''
    odd=''
    for i in range(len(num_list)):
        if num_list[i]%2==0:
            even=even+str(num_list[i])
        else:
            odd=odd+str(num_list[i])
    return int(even)+int(odd)
#num_list를 직접 반복하는게 나을듯 글고 +=를 str형태로 바로 가능