#1 마지막 두 원소
def solution(num_list):
    length=len(num_list)
    if num_list[length-1]>num_list[length-2]:
        num_list+=[num_list[length-1]-num_list[length-2]]
    else:
        num_list+=[num_list[length-1]*2]
    return num_list

#2 수 조작하기 1
def solution(n, control):
    for i in control:
        if i=='w':
            n+=1
        elif i=='s':
            n-=1
        elif i=='d':
            n+=10
        elif i=='a':
            n-=10
    return n

#3 수 조작하기 2
def solution(numLog):
    result=''
    for i in range(len(numLog)-1):
        if numLog[i+1]-numLog[i]==1:
            result+='w'
        elif numLog[i+1]-numLog[i]==-1:
            result+='s'
        elif numLog[i+1]-numLog[i]==10:
            result+='d'
        elif numLog[i+1]-numLog[i]==-10:
            result+='a'
    return result

