# 물어본 풀이
def solution(arr, queries):
    for i, j in queries:
        arr[i], arr[j] = arr[j], arr[i]
    return arr
#arr[i], arr[j] = arr[j], arr[i] 이것은 서로 동시에 바꿀때 사용

#5 수열과 구간 쿼리 2
def solution(arr, queries):
    answer =[]
    test=[]
    for s,e,k in queries:
        for j in arr[s:e+1]:
            if int(j) <= k:
                continue
            else:
                test+=[j]
        answer+=[min(test)] if test!=[] else [-1] 
        test=[]
    return answer