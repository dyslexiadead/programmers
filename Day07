#1 수열과 구간 쿼리4
def solution(arr, queries):
    for s, e, k in queries:
        for i in range(s, e + 1):
            if i % k == 0:
                arr[i] += 1
    return arr
#range(len(arr[s:e+1]))와 같이 쓰게 되면 s의 범위가 0으로 고정이 됌

