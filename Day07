#3 카운트 업
def solution(start_num, end_num):
    answer=[]
    for i in range(start_num,end_num+1):
        answer+=[i]
    return answer

#4 콜라츠 수열 만들기
def solution(n):
    answer = []
    while True:
        answer+=[n]
        if n==1:
            break
        elif n%2==0:
            n=n/2
        else:
            n=3*n+1
    return answer

#5 배열 만들기 4
def solution(arr):
    stk = []
    i=0
    while i<len(arr):
        if stk==[]:
            stk+=[arr[i]]
            i+=1
        elif stk!=[] and stk[-1]<arr[i]:
            stk+=[arr[i]]
            i+=1
        elif stk!=[] and stk[-1]>=arr[i]:
            del stk[-1]
            continue
    return stk