#1 문자 개수 세기*
def solution(my_string):
    answer = [0]*52
    for i in my_string:
        print(ord('a'))
        if i.isupper():
            answer[ord(i)-65]+=1
        else:
            answer[ord(i)-71]+=1
    return answer
