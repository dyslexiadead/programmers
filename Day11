#2 배열 만들기
def solution(n, k):
    answer = []
    for i in range(n):
        if (i+1)%k==0:
            answer+=[i+1]
    return answer

#3 글자 지우기
def solution(my_string, indices):
    answer=''
    list1 = list(my_string)
    for i in indices:
        list1[i]=''
    for i in list1:
        answer+=i
    return answer
#if문이나 for문을 한줄로 작성하는 방법 익히기

#4 카운트 다운
def solution(start_num, end_num):
    answer = []
    for i in range(start_num-end_num+1):
        answer+=[start_num-i]
    answer.sort(reverse=True)
    return answer

