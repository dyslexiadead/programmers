#1 리스트 자르기
def solution(n, slicer, num_list):
    answer = []
    a=slicer[0]
    b=slicer[1]
    c=slicer[2]
    if n==1:
        answer=num_list[0:b+1]
    elif n==2:
        answer=num_list[a:]
    elif n==3:
        answer=num_list[a:b+1]
    else:
        answer=num_list[a:b+1:c]
    return answer

#2 첫 번째로 나오는 음수
def solution(num_list):
    for i in num_list:
        if i<0:
            return num_list.index(i)
    return -1

#3 배열 만들기 3
def solution(arr, intervals):
    answer = []
    for j,k in intervals:
        answer+=arr[j:k+1]
    return answer

#4 2의 영역
def solution(arr):
    a=-1
    b=-1
    for i in range(len(arr)):
        if arr[i]==2:
            if a==-1:
                a=i
            else:
                b=i
    if a!=-1 and b!=-1:
        return arr[a:b+1]
    elif a!=-1 and b==-1:
        return [arr[a]]
    return [-1]
