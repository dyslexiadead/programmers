#1 홀수 vs 짝수
def solution(num_list):
    z=0
    h=0
    for i in range(len(num_list)):
        if i%2==0:
            z+=num_list[i]
        else:
            h+=num_list[i]
    return z if z>h else h

#2 5명씩
def solution(names):
    answer = []
    for i in range(len(names)):
        if i%5==0:
            answer+=[names[i]]
    return answer
