#3 할 일 목록
def solution(todo_list, finished):
    answer = []
    for i in range(len(todo_list)):
        if not(finished[i]):
            answer+=[todo_list[i]]
    return answer

#4 n보다 커질 때까지 더하기
def solution(numbers, n):
    answer = 0
    for i in numbers:
        if answer>n:
            return answer
        answer+=i
    return answer

#5 수열과 구간 쿼리1
def solution(arr, queries):
    for s,e in queries:
        for i in range(s,e+1):
            if s<=i and i<=e:
                arr[i]+=1
    return arr