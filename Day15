#1 조건에 맞게 수열 변환하기 1
def solution(arr):
    answer = []
    for i in arr:
        if i>=50 and i%2==0:
            answer+=[i/2]
        elif i<50 and i%2!=0:
            answer+=[i*2]
        else:
            answer+=[i]
    return answer

#2 조건에 맞게 수열 변환하기 2
def solution(arr):
    answer = 0
    ne=[]
    while ne!=arr:
        answer+=1
        for i in arr:
            if i>=50 and i%2==0:
                ne+=[i/2]
            elif i<50 and i%2!=0:
                ne+=[i*2+1]
            else:
                ne+=[i]
        if ne==arr:
            break
        else:
            arr=ne
            ne=[]
    return answer-1
