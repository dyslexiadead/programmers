#1 특정 문자열로 끝나는 가장 긴 부분 문자열 찾기
def solution(myString, pat):
    answer = ''
    for i in myString[::-1]:
        answer+=i
    index=answer.index(pat[::-1])
    if index==0:
        return myString[:]
    return myString[:-index]

#2 문자열이 몇 번 등장하는지 세기
def solution(myString, pat):
    answer = 0
    length=len(pat)
    for i in range(len(myString)):
        if myString[i:i+length]==pat:
            answer+=1
    return answer

