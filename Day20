#1 배열의 길이를 2의 거듭제곱으로 만들기
def solution(arr):
    answer = arr
    for i in range(11):
        if len(arr)==2**(i):
            return answer
        if len(arr)<2**(i):
            answer+=[0]*((2**i)-len(arr))
            return answer
        
#2 배열 비교하기
def solution(arr1, arr2):
    if len(arr1)==len(arr2):
        if sum(arr1)>sum(arr2):
            return 1
        elif sum(arr1)<sum(arr2):
            return -1
    else:
        if len(arr1)>len(arr2):
            return 1
        elif len(arr1)<len(arr2):
            return -1
    return 0

#3 문자열 묶기
def solution(strArr):
    answer = [0]*31
    for i in range(len(strArr)):
        answer[len(strArr[i])]+=1
    return max(answer)
