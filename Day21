#2 전국 대회 선발 고사
def solution(rank, attendance):
    answer=0
    ranking=[]
    for i in range(len(rank)):
        if attendance[i]:
            ranking+=[rank[i]]
    ranking.sort()
    ranking=ranking[:3]
    for i in ranking:
        answer+=10**(4-ranking.index(i)*2)*rank.index(i)
    return answer

