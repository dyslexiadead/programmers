#4 배열의 원소 삭제하기
def solution(arr, delete_list):
    answer = arr
    for i in delete_list:
        if i in arr:
            answer.remove(i)
    return answer

#5 부분 문자열인지 확인하기
def solution(my_string, target):
    return 1 if target in my_string else 0