#1 0 떼기
def solution(n_str):
    answer = n_str
    while answer[0]=='0':
        answer=answer[1:]
    return answer

#2 두 수의 합
def solution(a, b):
    answer=''
    carry=0
    if len(a)>len(b):
        b='0'*(len(a)-len(b))+b
    elif len(b)>len(a):
        a='0'*(len(b)-len(a))+a
    for j,k in zip(a[::-1],b[::-1]):
        hap= int(j)+int(k)+carry
        answer+=str(hap%10)
        carry=hap//10   
    if carry!=0:
        answer+=str(carry)
    return answer[::-1]
