#1 부분 문자열
def solution(str1, str2):
    return 1 if str1 in str2 else 0

#2 꼬리 문자열
def solution(str_list, ex):
    answer = ''
    for i in str_list:
        if ex not in i:
            answer+=i
    return answer

#3 정수 찾기
def solution(num_list, n):
    return 1 if n in num_list else 0

#4 주사위 게임 1
def solution(a, b):
    answer = 0
    if a%2==1 and b%2==1:
        return a**2 + b**2
    elif (a+b)%2==1:
        return 2*(a+b)
    else:
        answer=a-b
    return answer if answer>=0 else (-1)*answer

#5 날짜 비교하기*
def solution(date1, date2):
    for d1,d2 in zip(date1,date2):
        if d2>d1:
            return 1
        elif d2<d1:
            return 0
        elif d2==d1:
            continue
    return 0
